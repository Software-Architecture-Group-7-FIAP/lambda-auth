# Exemplo sem credenciais. DATABASE_URL e JWT_KMS_KEY_ID devem vir de configuração segura.
LOG_LEVEL=WARNING
# Use DATABASE_URL apenas no desenvolvimento local; nunca inclua credenciais aqui.
DATABASE_URL=
DATABASE_SECRET_ID=
JWT_ISSUER=https://auth.example.invalid
JWT_AUDIENCE=auto-shop-api
JWT_TTL_SECONDS=900
JWT_KID=local-placeholder
JWT_KMS_KEY_ID=
# Chaves adicionais publicadas no JWKS durante rotação; nunca usadas para assinatura.
JWT_ADDITIONAL_PUBLIC_KEYS_JSON=[]
AWS_REGION=
CORS_ALLOWED_ORIGIN=
