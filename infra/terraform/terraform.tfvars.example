aws_region          = "<approved-region>"
expected_account_id = "<12-digit-account-id>"
environment         = "hml"
lambda_package_path = "../../dist/lambda-auth.zip"

database_secret_id = "auto-shop/staging/hml/lambda-auth"
jwt_kms_key_arn     = "arn:aws:kms:<region>:<account-id>:key/<key-id>"
jwt_kid             = "<approved-key-id>"
jwt_additional_public_keys = []
jwt_issuer          = "https://<approved-issuer>"
jwt_audience        = "<approved-audience>"

# HML and PRD require approved private subnets and a security group that can
# reach PostgreSQL. Only dev may leave both lists empty.
private_subnet_ids = ["<approved-private-subnet-id>"]
security_group_ids = ["<approved-lambda-security-group-id>"]

# Set only when the database secret uses a customer-managed KMS key.
database_secret_kms_key_arn = ""

# Optional. Leave empty/commented unless the platform approved publishing the
# Lambda ARN to one of the exact SSM paths documented in README.md.
# function_arn_ssm_parameter_name = ""
